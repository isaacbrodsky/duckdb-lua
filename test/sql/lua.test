# name: test/sql/lua.test
# description: test lua extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT lua('Sam');
----
Catalog Error: Scalar Function with name lua does not exist!

# Require statement will ensure this test is run with this extension loaded
require lua

# Confirm the extension works
query I
SELECT lua('return 1 + 2');
----
3

query I
SELECT lua('return "aa" .. "bb"');
----
aabb

query I
SELECT lua('return _VERSION');
----
Lua 5.5

query I
SELECT lua('return 1 > 2');
----
false

query I
SELECT lua('return 1 < 2');
----
true

statement error
SELECT lua('1 < 2');
----
Lua Error: [string "line"]:1: unexpected symbol near '1'

# Invalid code
statement error
SELECT lua('aaa');
----
Lua Error: [string "line"]:1: syntax error near <eof>

statement error
SELECT lua('error({})');
----
Lua Error: Unknown type: table

query I
SELECT lua('return "abc"') FROM range(0, 5) tbl(i);
----
abc
abc
abc
abc
abc

query II
SELECT lua('return "abc"'), i FROM range(0, 5) tbl(i);
----
abc	0
abc	1
abc	2
abc	3
abc	4

query I
SELECT lua('return "abc' || cast(i as varchar) || '"') FROM range(0, 5) tbl(i);
----
abc0
abc1
abc2
abc3
abc4

query I
SELECT lua(if(i < 3, 'return "abc' || cast(i as varchar) || '"', null)) FROM range(0, 5) tbl(i);
----
abc0
abc1
abc2
NULL
NULL

query I
SELECT lua('function fn() return "Can not serialize function" end; return fn');
----
Unknown type: function

query I
SELECT lua(s)
FROM (VALUES
    ('return "A" .. "B"'),
    (NULL),
    ('return true'),
    ('return false'),
    ('return -1'),
) AS t(s);
----
AB
NULL
true
false
-1

statement error
SELECT lua(s)
FROM (VALUES
    ('return "A" .. "B"'),
    (NULL),
    ('return true'),
    ('return false'),
    ('invalid'),
) AS t(s);
----
Lua Error: [string "line"]:1: syntax error near <eof>
